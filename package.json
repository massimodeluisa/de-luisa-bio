{
  "name": "de-luisa-bio",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "packageManager": "bun@1.3.6",
  "scripts": {
    "dev": "run-p dev:site worker:dev",
    "dev:site": "vite",
    "worker:dev": "bun worker/dev-server.ts",
    "build": "run-p type-check \"build-only {@}\" --",
    "preview": "vite preview",
    "build-only": "bun scripts/generate-icons.ts && vite-ssg build && bun scripts/generate-og.ts && bun scripts/generate-favicons.ts && bun scripts/generate-seo.ts",
    "type-check": "vue-tsc --build",
    "lint": "run-s lint:*",
    "lint:oxlint": "oxlint . --fix",
    "lint:eslint": "eslint . --fix --cache",
    "format": "oxfmt src/"
  },
  "dependencies": {
    "@tailwindcss/vite": "^4.3.0",
    "@unhead/vue": "^2.1.2",
    "@vueuse/core": "^14.3.0",
    "browser-image-compression": "^2.0.2",
    "i18next": "^26.3.1",
    "posthog-js": "^1.381.0",
    "tailwindcss": "^4.3.0",
    "vue": "beta",
    "vue-router": "^5.1.0"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20260606.1",
    "@fontsource/fraunces": "^5.2.9",
    "@fontsource/geist-mono": "^5.2.8",
    "@fontsource/geist-sans": "^5.2.5",
    "@fontsource/inter": "^5.2.8",
    "@fontsource/jetbrains-mono": "^5.2.8",
    "@fontsource/space-grotesk": "^5.2.10",
    "@resvg/resvg-js": "^2.6.2",
    "@tsconfig/node24": "^24.0.4",
    "@types/node": "^25.9.2",
    "@vitejs/plugin-vue": "^6.0.7",
    "@vue/eslint-config-typescript": "^14.8.0",
    "@vue/language-plugin-pug": "^3.3.3",
    "@vue/tsconfig": "^0.9.1",
    "beasties": "^0.4.2",
    "eslint": "^10.4.1",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-oxlint": "~1.68.0",
    "eslint-plugin-vue": "~10.9.2",
    "jiti": "^2.7.0",
    "npm-run-all2": "^9.0.1",
    "oxfmt": "^0.53.0",
    "oxlint": "~1.68.0",
    "pug": "^3.0.4",
    "sass": "^1.100.0",
    "satori": "^0.26.0",
    "sharp": "^0.34.5",
    "typescript": "~6.0.3",
    "vite": "^8.0.16",
    "vite-plugin-vue-devtools": "^8.1.2",
    "vite-ssg": "^28.3.0",
