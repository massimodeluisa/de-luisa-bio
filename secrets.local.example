# Local secret dump — COPY to secrets.local (gitignored) then fill from your host dashboard.
# Never commit secrets.local. After a real GitHub Fork (Fork button) for an instance
# (e.g. deluisa.bio), re-upload these values to that fork's GitHub Actions Secrets /
# Variables and Worker secrets — not to a manually copied repo.

# --- GitHub Actions Secrets (Deploy worker) ---
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ACCOUNT_ID=
SESSION_SECRET=
ADMIN_GITHUB_TOKEN=
POSTHOG_READ_KEY=
ADMIN_USERS=
ISREADYAI_API_KEY=

# --- GitHub Actions Variables (public, Deploy site) ---
VITE_POSTHOG_KEY=
VITE_POSTHOG_HOST=https://eu.i.posthog.com
VITE_ADMIN_API=https://api.openbio.page

# --- Worker / serverless runtime ---
GITHUB_TOKEN=
GITHUB_REPO=your-org/openbio
GITHUB_BRANCH=master
POSTHOG_HOST=https://eu.posthog.com
POSTHOG_PROJECT_ID=
ALLOWED_ORIGIN=https://openbio.page
