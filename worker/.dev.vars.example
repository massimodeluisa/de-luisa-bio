# Copy to `worker/.dev.vars` (gitignored). Never commit real secrets.
# Generate ADMIN_USERS with: bun worker/hash-password.ts <user> <slug> <password>

SESSION_SECRET="change-me-to-a-long-random-string"
GITHUB_TOKEN=""
POSTHOG_READ_KEY=""
ADMIN_USERS='[]'
GITHUB_REPO="your-org/openbio"
GITHUB_BRANCH="master"
POSTHOG_HOST="https://eu.posthog.com"
POSTHOG_PROJECT_ID=""
ALLOWED_ORIGIN="http://localhost:5173"
