# Copy to `.env.local` for local dev (only PUBLIC values — never put secrets here,
# anything VITE_* is shipped to the browser).

# PostHog public project key + ingestion host.
VITE_POSTHOG_KEY=phc_xxx
VITE_POSTHOG_HOST=https://eu.i.posthog.com

# Optional Google Tag Manager container (leave empty on the Open Bio Page template).
# VITE_GTM_ID=GTM-XXXXXXX

# Admin API Worker URL. Local: http://localhost:8787 (the Bun dev-server).
# Prod: the admin API same-site custom domain, e.g. https://api.openbio.page
# (set as a GitHub repo Variable on your GitHub Fork). It MUST be a subdomain
# of your public site domain from content/site.json — a *.workers.dev URL is
# cross-site, so Safari blocks the session cookie and every authenticated call 401s.
VITE_ADMIN_API=http://localhost:8787
